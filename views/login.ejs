<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Masuk - Olimpiade Mata Pelajaran</title>
    <link rel="stylesheet" href="/output.css">
</head>
<body class="bg-slate-100 flex items-center justify-center min-h-screen p-4 text-slate-800">

    <div class="bg-white p-8 rounded-2xl shadow-md border border-slate-200 w-full max-w-md">
        <!-- Judul -->
        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold text-slate-900">Selamat Datang di Portal Olimpiade</h1>
            <p class="text-sm text-slate-500 mt-1">Silakan masuk untuk melanjutkan ke dasbor Anda.</p>
        </div>

        <!-- Pesan Sukses / Error dari EJS -->
        <% if (pesan_sukses) { %>
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3.5 rounded-xl mb-4 text-sm">
                <%= pesan_sukses %>
            </div>
        <% } %>

        <% if (pesan_error) { %>
            <div class="bg-rose-50 border border-rose-200 text-rose-800 p-3.5 rounded-xl mb-4 text-sm">
                <%= pesan_error %>
            </div>
        <% } %>

        <!-- Form Login -->
        <form action="/masuk" method="POST" class="space-y-4">
            <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Alamat Surel</label>
                <input type="email" id="email" name="email" placeholder="Alamat Surel" required
                    class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none transition">
            </div>

            <div>
                <label for="kata_sandi" class="block text-sm font-medium text-slate-700 mb-1">Kata Sandi</label>
                <input type="password" id="kata_sandi" name="kata_sandi" placeholder="Kata Sandi" required
                    class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none transition">
            </div>

            <button type="submit" 
                class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-lg transition shadow-sm mt-2">
                Masuk
            </button>
        </form>
    </div>

</body>
</html>