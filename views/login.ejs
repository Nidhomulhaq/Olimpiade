<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Masuk - Olimpiade Mata Pelajaran</title>
    <link rel="stylesheet" href="/output.css">
</head>
<body class="bg-slate-100 flex items-center justify-center min-h-screen p-4">

    <div class="bg-white p-8 rounded-2xl shadow-md w-full max-w-md text-center">
        <h1 class="text-2xl font-bold text-indigo-600 mb-2">Selamat Datang di Portal Olimpiade</h1>
        <p class="text-sm text-slate-500 mb-6">Silakan masuk untuk melanjutkan ke dasbor Anda.</p>
        
        <form action="/masuk" method="POST" class="space-y-4">
            <div class="text-left">
                <label class="block text-sm font-medium text-slate-700 mb-1">Alamat Surel</label>
                <input type="email" name="email" placeholder="Alamat Surel" required 
                    class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            </div>
            
            <div class="text-left">
                <label class="block text-sm font-medium text-slate-700 mb-1">Kata Sandi</label>
                <input type="password" name="kata_sandi" placeholder="Kata Sandi" required 
                    class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            </div>
            
            <button type="submit" 
                class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg transition shadow-sm mt-2">
                Masuk
            </button>
        </form>
    </div>

</body>
</html>