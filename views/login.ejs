<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Masuk - Olimpiade Mata Pelajaran</title>
</head>
<body>
    <div style="text-align: center; margin-top: 50px;">
        <h1>Selamat Datang di Portal Olimpiade</h1>
        <p>Silakan masuk untuk melanjutkan ke dasbor Anda.</p>
        
        <!-- Nanti kita akan merapikan ini menggunakan CSS (Bootstrap/Tailwind) -->
        <form action="/masuk" method="POST">
            <input type="email" name="email" placeholder="Alamat Surel" required>
            <br><br>
            <input type="password" name="kata_sandi" placeholder="Kata Sandi" required>
            <br><br>
            <button type="submit">Masuk</button>
        </form>
    </div>
</body>
</html>