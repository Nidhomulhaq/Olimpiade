<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verifikasi Dokumen - Panitia</title>
    <style>
        body { font-family: sans-serif; margin: 20px; }
        .navigasi { margin-bottom: 20px; }
        .navigasi a { margin-right: 15px; text-decoration: none; color: #0056b3; }
        .wadah { max-width: 1000px; margin: auto; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ccc; padding: 10px; text-align: center; }
        th { background-color: #f8f9fa; }
        img { max-width: 150px; height: auto; display: block; margin: 0 auto; border-radius: 4px; }
        .btn-terima { background-color: #28a745; color: white; border: none; padding: 6px 12px; cursor: pointer; border-radius: 4px; }
        .btn-tolak { background-color: #dc3545; color: white; border: none; padding: 6px 12px; cursor: pointer; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="wadah">
        <div class="navigasi">
            <a href="/dasbor-panitia">&larr; Kembali ke Dasbor</a>
            <a href="/keluar">Keluar</a>
        </div>

        <h2>Verifikasi Dokumen Pendaftaran</h2>
        <p>Halo, <strong><%= nama %></strong>! Berikut adalah daftar dokumen peserta yang menunggu verifikasi:</p>

        <% if (daftarDokumen.length === 0) { %>
            <p>Belum ada dokumen peserta yang masuk ke dalam sistem.</p>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th>Nama Peserta</th>
                        <th>Asal Sekolah</th>
                        <th>Kartu Pelajar</th>
                        <th>Bukti Pembayaran</th>
                        <th>Status / Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% daftarDokumen.forEach(function(dok) { %>
                        <tr>
                            <td><%= dok.pengguna.nama_lengkap %></td>
                            <td><%= dok.asal_sekolah %></td>
                            <td>
                                <!-- Memanggil tautan publik Supabase secara langsung -->
                                <a href="<%= dok.berkas_identitas %>" target="_blank">
                                    <img src="<%= dok.berkas_identitas %>" alt="Kartu Pelajar">
                                </a>
                            </td>
                            <td>
                                <!-- Memanggil tautan publik Supabase secara langsung -->
                                <a href="<%= dok.bukti_pembayaran %>" target="_blank">
                                    <img src="<%= dok.bukti_pembayaran %>" alt="Bukti Pembayaran">
                                </a>
                            </td>
                            <td>
                                <% if (dok.status_verifikasi === 'menunggu') { %>
                                    <form action="/panitia/verifikasi/<%= dok.id_dokumen %>" method="POST" style="display:inline-block; margin: 2px;">
                                        <input type="hidden" name="aksi" value="terima">
                                        <button type="submit" class="btn-terima">Terima</button>
                                    </form>
                                    <form action="/panitia/verifikasi/<%= dok.id_dokumen %>" method="POST" style="display:inline-block; margin: 2px;">
                                        <input type="hidden" name="aksi" value="tolak">
                                        <button type="submit" class="btn-tolak">Tolak</button>
                                    </form>
                                <% } else { %>
                                    <strong style="text-transform: capitalize;"><%= dok.status_verifikasi %></strong>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } %>
    </div>
</body>
</html>