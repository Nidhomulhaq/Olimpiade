<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dasbor Panitia - Olimpiade</title>
    <link rel="stylesheet" href="/output.css">
</head>
<body class="bg-slate-100 min-h-screen text-slate-800">

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <span class="bg-indigo-600 text-white font-bold px-2.5 py-1 rounded-lg text-sm">Panitia</span>
                <h1 class="text-lg font-bold text-slate-900 hidden sm:block">Portal Panitia Olimpiade</h1>
            </div>
            <div class="flex items-center space-x-3 sm:space-x-4 text-sm font-medium">
                <a href="/panitia/verifikasi" class="text-slate-600 hover:text-indigo-600 transition">Verifikasi Dokumen</a>
                <a href="/panitia/soal" class="text-slate-600 hover:text-indigo-600 transition">Manajemen Soal</a>
                <a href="/panitia/ujian" class="text-slate-600 hover:text-indigo-600 transition">Ruang Ujian</a>
                <a href="/keluar" class="bg-rose-50 text-rose-600 hover:bg-rose-100 px-3 py-1.5 rounded-lg transition">Keluar</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- Welcome Section & Quick Menu -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 mb-8">
            <h2 class="text-2xl font-bold text-slate-900">Dasbor Panitia</h2>
            <p class="text-slate-500 text-sm mt-1">Kelola pendaftaran peserta, verifikasi berkas, serta bank soal olimpiade.</p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
                <a href="/panitia/verifikasi" class="p-4 rounded-xl border border-slate-200 hover:border-indigo-500 hover:shadow-md transition bg-slate-50 group block">
                    <div class="font-bold text-indigo-600 group-hover:text-indigo-700">📋 Verifikasi Dokumen Peserta</div>
                    <p class="text-xs text-slate-500 mt-1">Periksa kartu pelajar & bukti pembayaran peserta.</p>
                </a>
                <a href="/panitia/soal" class="p-4 rounded-xl border border-slate-200 hover:border-indigo-500 hover:shadow-md transition bg-slate-50 group block">
                    <div class="font-bold text-indigo-600 group-hover:text-indigo-700">📝 Manajemen Soal</div>
                    <p class="text-xs text-slate-500 mt-1">Tambah, edit, dan atur kunci jawaban ujian.</p>
                </a>
                <a href="/panitia/ujian" class="p-4 rounded-xl border border-slate-200 hover:border-indigo-500 hover:shadow-md transition bg-slate-50 group block">
                    <div class="font-bold text-indigo-600 group-hover:text-indigo-700">🖥️ Ruang Pantau Ujian</div>
                    <p class="text-xs text-slate-500 mt-1">Pantau status peserta yang sedang mengerjakan ujian.</p>
                </a>
            </div>
        </div>

        <!-- Tabel Daftar Peserta -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="p-6 border-b border-slate-200">
                <h3 class="text-lg font-bold text-slate-900">Daftar Peserta Terdaftar</h3>
                <p class="text-xs text-slate-500 mt-0.5">Status kelengkapan berkas dan kelayakan ujian seluruh peserta.</p>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-3">Nama Lengkap</th>
                            <th class="px-6 py-3">Email</th>
                            <th class="px-6 py-3">Asal Sekolah</th>
                            <th class="px-6 py-3">Status Tahapan</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% daftar_peserta.forEach(peserta => { %>
                            <tr class="hover:bg-slate-50/50 transition">
                                <td class="px-6 py-4 font-medium text-slate-900"><%= peserta.nama_lengkap %></td>
                                <td class="px-6 py-4"><%= peserta.email %></td>
                                <td class="px-6 py-4"><%= peserta.asal_sekolah || '-' %></td>
                                <td class="px-6 py-4">
                                    <% if (peserta.status_tahapan === 'isi_data') { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                            Belum Lengkap
                                        </span>
                                    <% } else if (peserta.status_tahapan === 'menunggu_verifikasi') { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-100 text-sky-800">
                                            Menunggu Verifikasi
                                        </span>
                                    <% } else if (peserta.status_tahapan === 'siap_ujian') { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                                            Siap Ujian
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
                                            <%= peserta.status_tahapan %>
                                        </span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

</body>
</html>