<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dasbor Peserta</title>
    <link rel="stylesheet" href="/output.css">
</head>
<body class="bg-slate-100 min-h-screen py-10 px-4">

    <div class="max-w-2xl mx-auto bg-white p-6 sm:p-8 rounded-2xl shadow-md border border-slate-200">
        <!-- Header -->
        <div class="border-b border-slate-200 pb-4 mb-6 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Portal Peserta Olimpiade</h1>
                <p class="text-slate-600 mt-1">Selamat datang, <strong class="text-indigo-600"><%= pengguna.nama_lengkap %></strong>.</p>
            </div>
        </div>

        <% if (pengguna.status_tahapan === 'isi_data') { %>
            <!-- Tampilan jika peserta belum mengunggah dokumen -->
            <div class="bg-amber-50 border border-amber-200 text-amber-800 p-4 rounded-xl mb-6 text-sm">
                <strong class="font-semibold">Perhatian:</strong> Anda harus melengkapi data dan mengunggah dokumen pendaftaran sebelum dapat mengikuti ujian.
            </div>

            <form action="/peserta/unggah" method="POST" enctype="multipart/form-data" class="space-y-5">
                <div>
                    <label for="asal_sekolah" class="block font-medium text-slate-700 mb-1">Asal Sekolah:</label>
                    <input type="text" id="asal_sekolah" name="asal_sekolah" required placeholder="Contoh: SMAN 1 Lamongan"
                        class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>

                <div>
                    <label for="berkas_identitas" class="block font-medium text-slate-700 mb-1">Unggah Kartu Pelajar (Gambar/PDF):</label>
                    <input type="file" id="berkas_identitas" name="berkas_identitas" accept="image/*,.pdf" required
                        class="w-full text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 border border-slate-300 rounded-lg">
                </div>

                <div>
                    <label for="bukti_pembayaran" class="block font-medium text-slate-700 mb-1">Unggah Bukti Pembayaran (Gambar/PDF):</label>
                    <input type="file" id="bukti_pembayaran" name="bukti_pembayaran" accept="image/*,.pdf" required
                        class="w-full text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 border border-slate-300 rounded-lg">
                </div>

                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-lg transition shadow-sm mt-4">
                    Kirim Dokumen
                </button>
            </form>

        <% } else if (pengguna.status_tahapan === 'menunggu_verifikasi') { %>
            <!-- Tampilan jika peserta sudah mengunggah dan sedang menunggu -->
            <div class="bg-sky-50 border border-sky-200 text-sky-800 p-4 rounded-xl mb-6 text-sm">
                <strong class="font-semibold">Tahap Verifikasi:</strong> Dokumen Anda telah diterima dan saat ini sedang dalam proses pengecekan oleh panitia. Silakan periksa kembali halaman ini secara berkala.
            </div>

        <% } else if (pengguna.status_tahapan === 'siap_ujian') { %>
            <!-- Tampilan jika dokumen diterima dan siap ujian -->
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-4 rounded-xl mb-6 text-sm">
                <strong class="font-semibold">Verifikasi Berhasil!</strong> Dokumen pendaftaran Anda telah disetujui. Anda sudah memenuhi syarat untuk mengikuti ujian.
            </div>
            <a href="/peserta/ujian" class="block">
                <button class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-lg transition shadow-sm">
                    Masuk ke Ruang Ujian Sekarang
                </button>
            </a>
        <% } %>

        <div class="mt-8 pt-4 border-t border-slate-100 text-center">
            <a href="/keluar" class="text-rose-600 hover:text-rose-700 font-medium text-sm transition inline-block">
                Keluar (Logout)
            </a>
        </div>
    </div>

</body>
</html>